# Supabase public keys (client side)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key (server side only, never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ---------------------------------------------------------------------------
# Admin studio (all four are required, otherwise the admin area returns 404)
# ---------------------------------------------------------------------------
# Secret URL segment for the admin studio, 8-64 chars [a-zA-Z0-9_-].
# The studio is served at https://your-domain/<ADMIN_PATH>. Keep it private.
ADMIN_PATH=change-me-to-a-random-string
ADMIN_USERNAME=change-me
# Generate both values below with:  npm run hash-password -- "your-strong-password"
ADMIN_PASSWORD_HASH=pbkdf2:310000:salt:hash
ADMIN_SESSION_SECRET=at-least-32-random-characters
